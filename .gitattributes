*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text

# Claude Code Game Studios — files that must keep LF line endings.
# core.autocrlf=true would otherwise check them out as CRLF, and a stray CR
# breaks bash on Git Bash, awk programs read with `awk -f`, and the substring
# matching that skill tooling does over SKILL.md files.
*.sh text eol=lf
*.awk text eol=lf
.worktreeinclude text eol=lf
*.tsv text eol=lf
.claude/**/*.md text eol=lf
