(fn OnHealthDamaged (Amount DamageCauser)
  (bind strength (Math|Float|MapRangeClamped Amount 0.0 50.0 0.5 1.0))
  (if (Variables|Default|GetProcessingSwordContact)
    (if (> (Class|UCHealthComponent|GetCurrentHealth (Variables|Default|GetHealth)) 0.0)
      (CallFunction|HitFlash :self self)
      (CallFunction|ApplyHitStop :self self :Duration 0.045 :Dilation 0.08)
      (CameraShakes|StartCameraShake :self (Game|GetPlayerCameraManager 0) :ShakeClass "/Game/Kutun/VFX/CameraShakes/CS_SwordCut.CS_SwordCut_C" :Scale 0.75)
      (Audio|SpawnSoundatLocation :Sound "/Game/Kutun/Audio/SFX/SW_Sword_Slice.SW_Sword_Slice" :Location (Variables|Default|GetLastSwordImpact) :VolumeMultiplier 0.9 :PitchMultiplier (Math|Random|RandomFloatinRange 0.97 1.06))
      (bind velocity (Transformation|GetVelocity DamageCauser))
      (bind direction (Math|Vector|Normalize2D(Vector) (select (> (Math|Vector|VectorLengthXY velocity) 100.0) velocity (- (Transformation|GetActorLocation self) (Transformation|GetActorLocation DamageCauser)))))
      (Character|LaunchCharacter :self self :LaunchVelocity (+ (* direction (Math|Float|Lerp 140.0 240.0 strength)) (Math|Vector|MakeVector 0.0 0.0 30.0)) :bXYOverride true :bZOverride false))
    (else
      (CallFunction|HitFlash :self self)
      (if (< Amount 1000.0)
        (CallFunction|ApplyKnockback self DamageCauser strength)
        (bind duration (Class|BPICombatTarget|ReceiveHitFeedback (Game|GetPlayerCharacter 0) strength DamageCauser self))
        (if (> (Class|UCHealthComponent|GetCurrentHealth (Variables|Default|GetHealth)) 0.0)
          (CallFunction|ApplyHitStop :self self :Duration duration :Dilation 0.05))))))
