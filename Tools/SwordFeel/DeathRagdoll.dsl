(fn DeathRagdoll ()
  (bind location (Transformation|GetActorLocation self))
  (bind mesh (Variables|Character|GetMesh))
  ; SeverVisual already supplied the cut accent. Do not stack it with a death accent.
  (if (not (Variables|Default|GetHitStopActive))
    (CameraShakes|StartCameraShake :self (Game|GetPlayerCameraManager 0) :ShakeClass "/Game/Kutun/VFX/CameraShakes/CS_SwordCut.CS_SwordCut_C" :Scale 1.6)
    (Audio|SpawnSoundatLocation :Sound "/Game/Kutun/Audio/SFX/SW_Sword_CritSlice.SW_Sword_CritSlice" :Location location :VolumeMultiplier 1.1 :PitchMultiplier (Math|Random|RandomFloatinRange 0.86 0.95)))
  (Utilities|Time|ClearTimerbyFunctionName self "EndHitStop")
  (Variables|Actor|SetCustomTimeDilation 1.0)
  (Variables|Default|SetHitStopActive false)
  ; Keep the player's aim and time scale intact during repeated kills.
  (Utilities|Time|ClearandInvalidateTimerbyHandle (Variables|Default|GetAttackTimer))
  (Utilities|Time|ClearTimerbyFunctionName self "ChasePlayer")
  (Animation|Montage|Montage_Stop (Components|SkeletalMesh|GetAnimInstance mesh) 0.0 0)
  (Pawn|Components|CharacterMovement|DisableMovement (Variables|Character|GetCharacterMovement))
  (Collision|SetCollisionEnabled (Variables|Default|GetSphere))
  (Collision|SetCollisionEnabled (Variables|Character|GetCapsuleComponent))
  (Collision|SetCollisionProfileName mesh "Ragdoll")
  (Physics|SetSimulatePhysics mesh true)
  (Physics|AddImpulseToAllBodiesBelow mesh (+ (* (Math|Vector|Normalize2D(Vector) (- location (Transformation|GetActorLocation (Game|GetPlayerPawn 0)))) 300.0) (Math|Vector|MakeVector 0.0 0.0 90.0)) "Hips" true))
