(fn SeverVisual (CutBone)
  (bind causer (Variables|Default|GetLastSwordCauser))
  (bind impact (Variables|Default|GetLastSwordImpact))
  (bind velocity (Transformation|GetVelocity causer))
  (bind direction (Math|Vector|Normalize2D(Vector) (select (> (Math|Vector|VectorLengthXY velocity) 100.0) velocity (- (Transformation|GetActorLocation self) (Transformation|GetActorLocation causer)))))
  (Class|CDismemberment|AnyDamage (Variables|Default|GetCDismemberment) 10000 CutBone causer self (+ (* direction 520.0) (Math|Vector|MakeVector 0.0 0.0 110.0)) impact)
  (Variables|Default|SetHitStopActive true)
  (Variables|Actor|SetCustomTimeDilation 0.06)
  (Utilities|Time|SetTimerbyFunctionName self "EndHitStop" 0.065)
  (CallFunction|HitFlash :self self)
  (CameraShakes|StartCameraShake :self (Game|GetPlayerCameraManager 0) :ShakeClass "/Game/Kutun/VFX/CameraShakes/CS_SwordCut.CS_SwordCut_C" :Scale 1.35)
  (Audio|SpawnSoundatLocation :Sound "/Game/Kutun/Audio/SFX/SW_Sword_CritSlice.SW_Sword_CritSlice" :Location impact :VolumeMultiplier 1.05 :PitchMultiplier (Math|Random|RandomFloatinRange 0.92 1.02)))
