(fn CheckTutorialAction ()
 (Utilities|IsValid (Variables|Default|GetTutorialPlayer) (:"Is Valid"
  (switch int (Variables|Default|GetTutorialKind)
   (:0)
   (:1 (if (and (AI|Components|NavMovement|IsFalling (Class|Character|GetCharacterMovement (Variables|Default|GetTutorialPlayer))) (> (.z (Transformation|GetVelocity (Variables|Default|GetTutorialPlayer))) 50.0)) (CallFunction|CompleteTutorial)))
   (:2 (if (== (Variables|Default|GetTutorialStep) 0) (if (Class|BPTelekinezi|GetIsGrabbing (Variables|Default|GetTutorialPlayer)) (Utilities|IsValid (Class|BPTelekinezi|GetCrushedComp (Variables|Default|GetTutorialPlayer)) (:"Is Valid" (Variables|Default|SetObservedComponent (Class|BPTelekinezi|GetCrushedComp (Variables|Default|GetTutorialPlayer))) (Variables|Default|SetObservedScale (Transformation|GetWorldScale (Variables|Default|GetObservedComponent))) (CallFunction|AdvanceTutorialStep)))) (else (if (not (Class|BPTelekinezi|GetIsGrabbing (Variables|Default|GetTutorialPlayer))) (CallFunction|CompleteTutorial)))))
   (:3 (if (== (Variables|Default|GetTutorialStep) 0) (if (Class|BPTelekinezi|GetIsGrabbing (Variables|Default|GetTutorialPlayer)) (Utilities|IsValid (Class|BPTelekinezi|GetCrushedComp (Variables|Default|GetTutorialPlayer)) (:"Is Valid" (Variables|Default|SetObservedComponent (Class|BPTelekinezi|GetCrushedComp (Variables|Default|GetTutorialPlayer))) (Variables|Default|SetObservedScale (Transformation|GetWorldScale (Variables|Default|GetObservedComponent))) (CallFunction|AdvanceTutorialStep)))) (else (Utilities|IsValid (Variables|Default|GetObservedComponent) (:"Is Valid" (if (> (Math|Vector|VectorLength (- (Transformation|GetWorldScale (Variables|Default|GetObservedComponent)) (Variables|Default|GetObservedScale))) 0.05) (CallFunction|CompleteTutorial))) (:"Is Not Valid" (CallFunction|RestartTutorial))))))
   (:4 (if (== (Variables|Default|GetTutorialStep) 0) (if (Class|BPTelekinezi|GetIsGrabbing (Variables|Default|GetTutorialPlayer)) (Utilities|IsValid (Class|BPTelekinezi|GetCrushedComp (Variables|Default|GetTutorialPlayer)) (:"Is Valid" (if (Physics|IsSimulatingPhysics (Class|BPTelekinezi|GetCrushedComp (Variables|Default|GetTutorialPlayer)) "None") (Variables|Default|SetObservedComponent (Class|BPTelekinezi|GetCrushedComp (Variables|Default|GetTutorialPlayer))) (Variables|Default|SetObservedScale (Transformation|GetWorldScale (Variables|Default|GetObservedComponent))) (CallFunction|AdvanceTutorialStep))))) (else (Utilities|IsValid (Variables|Default|GetObservedComponent) (:"Is Valid" (if (not (Physics|IsSimulatingPhysics (Variables|Default|GetObservedComponent) "None")) (CallFunction|CompleteTutorial))) (:"Is Not Valid" (CallFunction|RestartTutorial))))))
   (:5 (bind mount (Utilities|Casting|CastToBP_SwordMount :Object (Game|GetPlayerPawn 0))
     (:then (if (Class|BPSwordMount|GetIsMounted mount) (CallFunction|CompleteTutorial)))
     (:CastFailed)))
   (:6 (if (== (Variables|Default|GetTutorialStep) 0) (if (!= (Class|BPTelekinezi|GetSwordonHand (Variables|Default|GetTutorialPlayer)) (Variables|Default|GetInitialSwordState)) (CallFunction|AdvanceTutorialStep)) (else (if (== (Class|BPTelekinezi|GetSwordonHand (Variables|Default|GetTutorialPlayer)) (Variables|Default|GetInitialSwordState)) (CallFunction|CompleteTutorial)))))
   (:7 (if (== (Variables|Default|GetTutorialStep) 0) (if (Class|BPTelekinezi|GetIsGrabbing (Variables|Default|GetTutorialPlayer)) (Utilities|IsValid (Class|BPTelekinezi|GetCrushedComp (Variables|Default|GetTutorialPlayer)) (:"Is Valid" (Variables|Default|SetObservedComponent (Class|BPTelekinezi|GetCrushedComp (Variables|Default|GetTutorialPlayer))) (Variables|Default|SetObservedScale (Transformation|GetWorldScale (Variables|Default|GetObservedComponent))) (CallFunction|AdvanceTutorialStep)))) (else (Utilities|IsValid (Variables|Default|GetObservedComponent)
    (:"Is Valid" (if (and (not (Class|BPTelekinezi|GetIsGrabbing (Variables|Default|GetTutorialPlayer))) (and (== (Class|BPTelekinezi|GetLastThrownComp (Variables|Default|GetTutorialPlayer)) (Variables|Default|GetObservedComponent)) (> (Math|Vector|VectorLength (Transformation|GetComponentVelocity (Variables|Default|GetObservedComponent))) 300.0))) (CallFunction|CompleteTutorial)))
    (:"Is Not Valid" (CallFunction|CompleteTutorial))))))))))

